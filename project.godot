; Engine configuration file.
config_version=5

[application]

config/name="USPSA VR Range"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Defs="res://scripts/defs.gd"
Gun="res://scripts/gun.gd"
Mag="res://scripts/mag.gd"
RangeBuilder="res://scripts/range_builder.gd"
Target="res://scripts/target.gd"
Barricade="res://scripts/barricade.gd"
Drills="res://scripts/drills.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/vsync/vsync_mode=0

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="mobile"
vrs/mode=2
textures/vram_compression/import_etc2_astc=true

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/foveation_level=2
openxr/foveation_dynamic=true
openxr/extensions/eye_gaze_interaction=true
shaders/enabled=true
